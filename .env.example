# ── Database ────────────────────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://aria:aria@localhost:5432/aria

# ── AI Provider ─────────────────────────────────────────────────────────────────
# Option 1: Ollama (local, free, 100% private — recommended)
#   Install: https://ollama.com
#   Pull model: ollama pull qwen2.5:7b
# Use 127.0.0.1 (not localhost) — on Windows, localhost may resolve to IPv6 ::1
# while Ollama listens only on IPv4, causing ECONNREFUSED.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b

# Option 2: Any OpenAI-compatible cloud endpoint
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option 3: Groq (fast cloud inference, free tier — recommended for cloud mode)
#   Get a key at https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile
#   (If that model name errors, check the current list at
#    https://console.groq.com/docs/models — e.g. openai/gpt-oss-120b)

# Option 4: Together AI / Fireworks / Mistral / etc.
# Any provider that exposes an OpenAI-compatible /v1/chat/completions endpoint works.

# ── App ──────────────────────────────────────────────────────────────────────────
PORT=5000
SESSION_SECRET=change-me-in-production
NODE_ENV=development
