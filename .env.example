# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/aria_db

# ── AI Provider ─────────────────────────────────────────────────────────────────
# Option 1: Ollama (local, free, 100% private — recommended)
#   Install: https://ollama.com
#   Pull model: ollama pull qwen2.5:7b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b

# Option 2: Any OpenAI-compatible cloud endpoint
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option 3: Groq (fast cloud inference, free tier available)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.1-70b-versatile

# Option 4: Together AI / Fireworks / Mistral / etc.
# Any provider that exposes an OpenAI-compatible /v1/chat/completions endpoint works.

# ── App ──────────────────────────────────────────────────────────────────────────
PORT=5000
SESSION_SECRET=change-me-in-production
NODE_ENV=development
